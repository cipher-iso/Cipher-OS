#version 330 core

precision highp float;

uniform sampler2D tex;
uniform float time;
uniform vec2 resolution;

in vec2 v_texcoord;
out vec4 fragColor;

// --------------------------------------------------
// Utility
// --------------------------------------------------
float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898,78.233))) * 43758.5453);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    float a = rand(i);
    float b = rand(i + vec2(1.0, 0.0));
    float c = rand(i + vec2(0.0, 1.0));
    float d = rand(i + vec2(1.0, 1.0));

    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 6; i++) {
        v += a * noise(p);
        p *= 2.0;
        a *= 0.5;
    }
    return v;
}

// --------------------------------------------------
// Main
// --------------------------------------------------
void main() {
    vec2 uv = v_texcoord;
    vec2 px = 1.0 / resolution;

    // --- Time chaos ---
    float t = time * 0.8;
    float drift = sin(t * 0.3) * 0.003;

    // --- Vertical tape wobble ---
    float wobble = fbm(vec2(uv.y * 3.0, t * 0.4)) * 0.008;
    uv.x += wobble + drift;

    // --- Horizontal line jitter ---
    float line = sin(uv.y * resolution.y * 1.3 + t * 20.0);
    uv.x += line * 0.0009;

    // --- Scanline displacement ---
    float scanShift = sin(uv.y * resolution.y * 0.25) * 0.0012;
    uv.x += scanShift;

    // --- Chroma separation ---
    float chroma = 0.003 + sin(t * 2.0) * 0.001;

    vec3 col;
    col.r = texture(tex, uv + vec2(chroma, 0.0)).r;
    col.g = texture(tex, uv).g;
    col.b = texture(tex, uv - vec2(chroma, 0.0)).b;

    // --- VHS color bleed (horizontal smear) ---
    float bleed = fbm(vec2(uv.y * 8.0, t * 1.2)) * 0.006;
    col.r += texture(tex, uv - vec2(bleed, 0.0)).r * 0.15;
    col.b += texture(tex, uv + vec2(bleed, 0.0)).b * 0.15;

    // --- Luma flicker ---
    float flicker = rand(vec2(t, uv.y)) * 0.08;
    col *= 1.0 - flicker;

    // --- Film grain (HD, animated) ---
    float grain = rand(uv * resolution + time * 60.0);
    grain = mix(grain, rand(uv * resolution * 0.5), 0.5);
    col += (grain - 0.5) * 0.12;

    // --- Scanlines ---
    float scanline = sin(uv.y * resolution.y * 1.2);
    col *= 0.92 + 0.08 * scanline;

    // --- CRT shadow mask ---
    float mask = sin(uv.x * resolution.x * 3.1415);
    col *= 0.94 + 0.06 * mask;

    // --- Vignette ---
    vec2 vig = uv - 0.5;
    float vignette = 1.0 - dot(vig, vig) * 1.6;
    col *= vignette;

    // --- Occasional tape glitch lines ---
    float glitchLine = step(0.995, rand(vec2(floor(uv.y * 400.0), t)));
    col.rgb += glitchLine * vec3(0.4, -0.2, 0.3);

    // --- Analog gamma crush ---
    col = pow(col, vec3(1.2));

    fragColor = vec4(col, 1.0);
}

