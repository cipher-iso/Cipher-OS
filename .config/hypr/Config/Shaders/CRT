#version 300 es
// vim: set ft=glsl:
precision highp float;

// --- Input/Output ---
in vec2 v_texcoord;
out vec4 FragColor;

// --- Uniforms ---
uniform sampler2D tex;
uniform float time;
uniform int ASPECT_RATIO_MODE; // 4:3 mode

// --- Constants / Tweakables ---
#define FOURBYTHREE          1
#define VIBRANCE_STRENGTH    1.25   // 0 = off, 1 = normal, >1 = stronger RGB offset
#define CURVATURE            0.015
#define CONVERGENCE_BASE     0.002
#define CRT_GAMMA            1.0
#define CONTRAST             1.2
#define BLOOM_STRENGTH       0.35
#define PHOSPHOR_GLOW        0.02
#define PHOSPHOR_PERSISTENCE 0.38
#define GRAIN_STRENGTH       0.015
#define BLUR_STRENGTH        0.0006
#define BEAM_WIDTH           0.3
#define VERTICAL_JITTER      3.5
#define HORIZONTAL_JITTER    0.00008
#define HPHASE_NOISE         0.00015
#define VDRIFT_STRENGTH      0.00005
#define SHIMMER_STRENGTH     0.00035
#define SCANLINE_INTENSITY   0.02   // Subtle CRT scanline brightness
#define GRILLE_STRENGTH      0.25
#define NOISE_STRENGTH       0.015  // Overlay noise intensity
#define AA_FEATHER           0.0005 // width (in UV space) of the edge anti-aliasing fade

// --- Hash & Noise ---
float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise1D(float x) {
    float i = floor(x);
    float f = fract(x);
    float a = hash(vec2(i, 0.0));
    float b = hash(vec2(i+1.0,0.0));
    return mix(a,b,f);
}

float crtNoise(vec2 uv) {
    float t = time * 75.0;
    float line = uv.y * 1440.0;
    float band = noise1D(line*0.6 + t);
    float grain = hash(floor(uv * vec2(2560.0,1440.0)) + t);
    return mix(grain, band, 0.6);
}

// --- Curvature ---
vec2 curve(vec2 uv) {
    uv = uv*2.0 - 1.0;
    uv *= 1.0 + (uv.yx * uv.yx) * CURVATURE;
    return uv*0.5 + 0.5;
}

// --- Edge anti-aliasing mask ---
// Smoothly fades a coordinate to 0 as it crosses outside [0,1], instead of a hard cutoff.
float edge1D(float v, float feather) {
    return smoothstep(0.0, feather, v) * smoothstep(0.0, feather, 1.0 - v);
}

// --- Scanlines & Grille (subtle, realistic CRT) ---
float scanline(vec2 uv) {
    // Soft sine-based lines for subtle CRT effect
    float line = sin(uv.y * 1440.0 * 3.1415); 
    return 1.0 - line * SCANLINE_INTENSITY; // very faint scanlines
}

vec3 apertureGrille(vec2 uv) {
    // Original triad stripes
    float x = uv.x * 2560.0;
    float stripe = mod(floor(x), 3.0);
    vec3 mask = vec3(0.85);
    if(stripe == 0.0) mask.r = 1.25;
    else if(stripe == 1.0) mask.g = 1.25;
    else mask.b = 1.25;
    return mix(vec3(1.0), mask, GRILLE_STRENGTH);
}

// --- Bloom & Phosphor ---
vec3 bloom(vec2 uv) {
    vec3 sum = vec3(0.0);
    float o = 1.0/900.0;
    sum += texture(tex, uv + vec2( o,0.0)).rgb;
    sum += texture(tex, uv + vec2(-o,0.0)).rgb;
    sum += texture(tex, uv + vec2(0.0, o)).rgb;
    sum += texture(tex, uv + vec2(0.0,-o)).rgb;
    return sum*0.25;
}

vec3 phosphor(vec2 uv, vec3 c) {
    float flicker = 0.97 + 0.03*sin(time*120.0 + uv.y*900.0);
    vec3 glow = bloom(uv)*PHOSPHOR_GLOW;
    return mix(c,(c+glow)*flicker,PHOSPHOR_PERSISTENCE);
}

// --- Blur ---
vec3 blur(vec2 uv) {
    vec3 sum = vec3(0.0);
    float o = BLUR_STRENGTH;
    for(int x=-1;x<=1;x++)
        for(int y=-1;y<=1;y++)
            sum += texture(tex, uv + vec2(float(x)*o, float(y)*o)).rgb;
    return sum/9.0;
}

// --- Gaussian Noise Overlay ---
float gaussianNoise(vec2 uv, float seed) {
    float u1 = fract(sin(dot(uv+seed,vec2(12.9898,78.233)))*43758.5453);
    float u2 = fract(sin(dot(uv+seed+1.0,vec2(12.9898,78.233)))*43758.5453);
    float z0 = sqrt(-2.0*log(u1+0.0001)) * cos(6.2831853*u2);
    return z0;
}

// --- Main ---
void main() {
    // --- Curvature first ---
    vec2 uv = curve(v_texcoord);

    // Accumulate an edge mask instead of hard-cutting to black.
    // Anything fully outside [0,1] (beyond the feather) will end up at mask = 0,
    // same visual result as before, but the boundary itself is now smoothed.
    float mask = edge1D(uv.x, AA_FEATHER) * edge1D(uv.y, AA_FEATHER);

    // --- 4:3 aspect ---
    if(ASPECT_RATIO_MODE == FOURBYTHREE){
        float newX = (uv.x-0.5)*(16.0/12.0)+0.5;
        mask *= edge1D(newX, AA_FEATHER);
        uv.x = newX;
    }

    // Clamp the coordinate used for sampling so we never read/wrap outside the
    // texture near the border (this is what removes the pixellated stair-stepping).
    uv = clamp(uv, 0.0, 1.0);

    // If we're fully outside (even the feather), skip the rest of the work and bail black.
    if(mask <= 0.0){
        FragColor = vec4(0.0,0.0,0.0,1.0);
        return;
    }

    // --- Jitter for CRT simulation ---
    vec2 uvSim = uv;
    uvSim.y += sin(time*100.0)*VDRIFT_STRENGTH;
    uvSim.x += (hash(vec2(floor(time*120.0),0.0))-0.5)*2.0*HORIZONTAL_JITTER;
    uvSim = clamp(uvSim, 0.0, 1.0);

    vec3 base = texture(tex, uvSim).rgb;
    base = pow(base, vec3(CRT_GAMMA));
    float luma = dot(base, vec3(0.2126,0.7152,0.0722));

    // --- Convergence (true red/blue chromatic aberration) ---
    vec2 center = vec2(0.5);
    vec2 dir = uvSim - center;
    float radius = length(dir);
    float fade = smoothstep(0.0, 1.0, radius);

    vec2 convOffset = normalize(dir + 1e-6) * (CONVERGENCE_BASE * fade);

    // Sample channels
    float r = texture(tex, clamp(uvSim + convOffset, 0.0, 1.0)).r;
    float g = texture(tex, uvSim).g;
    float b = texture(tex, clamp(uvSim - convOffset, 0.0, 1.0)).b;

    // Neutralize green bias slightly
    float convAvg = (r + g + b) / 3.0;
    g = mix(g, convAvg, 0.25);

    vec3 color = vec3(r, g, b);

    // --- Beam ---
    color *= mix(1.0,luma,BEAM_WIDTH);

    // --- Bloom, phosphor, contrast, grain, blur ---
    color += bloom(uvSim)*BLOOM_STRENGTH;
    color = phosphor(uvSim,color);
    color = (color-0.5)*CONTRAST + 0.5;
    float n = crtNoise(uvSim)-0.5;
    color += n*GRAIN_STRENGTH*(0.4+luma);
    color = mix(color, blur(uvSim),0.28);

    // --- Gaussian noise overlay ---
    color += gaussianNoise(v_texcoord, time)*NOISE_STRENGTH;

// --- Vibrance applied at the end (preserves colors) ---
float avg = (color.r + color.g + color.b) / 3.0;
color.r += (color.r - avg) * (VIBRANCE_STRENGTH - 1.0);
color.g += (color.g - avg) * (VIBRANCE_STRENGTH - 1.0);
color.b += (color.b - avg) * (VIBRANCE_STRENGTH - 1.0);

    // --- Subtle CRT scanlines ---
    float scan = sin(uv.y*1440.0*3.1415) * SCANLINE_INTENSITY;
    color -= scan;

    color = clamp(color,0.0,1.0);

// --- Final: grille (ALWAYS straight, never curved) ---
    vec3 grille = apertureGrille(v_texcoord);
    color *= grille;

    // --- Apply the smooth edge mask last so the curvature border fades cleanly ---
    color *= mask;

    FragColor = vec4(color,1.0);
}
