  ┃   ┗┓┗┫┗┓ ┃ ┣ ┃┃┃  ┃┃┃┃┃┃┣┫ ┃ ┣    ┃
  ┗━  ┗┛┗┛┗┛ ┻ ┗┛┛ ┗  ┗┛┣┛┻┛┛┗ ┻ ┗┛  ━┛\e[0m\n"

    sudo -p "$SUDO_PROMPT" pacman -Syu

    printf "\e[38;2;0;255;64m  ┏━  ┳┳┏┓┏┓┳┓  ┳┓┏┓┏┓┏┓┏┓┳┏┳┓┏┓┳┓┳┏┓┏┓  ━┓
  ┃   ┃┃┗┓┣ ┣┫  ┣┫┣ ┃┃┃┃┗┓┃ ┃ ┃┃┣┫┃┣ ┗┓   ┃
  ┗━  ┗┛┗┛┗┛┛┗  ┛┗┗┛┣┛┗┛┗┛┻ ┻ ┗┛┛┗┻┗┛┗┛  ━┛\e[0m\n"

    if command -v yay &> /dev/null; then
