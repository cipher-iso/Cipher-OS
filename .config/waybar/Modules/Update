  ┃   ┣ ┃ ┣┫ ┃ ┃┃┣┫┃┫   ┗┓┃┃┣  ┃ ┃┃┃┣┫┣┫┣    ┃
  ┗━  ┻ ┗┛┛┗ ┻ ┣┛┛┗┛┗┛  ┗┛┗┛┻  ┻ ┗┻┛┛┗┛┗┗┛  ━┛\e[0m\n"
        flatpak update -y
    fi

    printf "\e[38;2;0;255;64m  ┏━  ┳┳┏┓┳┓┏┓┏┳┓┏┓┏┓  ┏┓┏┓┳┳┓┏┓┓ ┏┓┏┳┓┏┓╻  ━┓
  ┃   ┃┃┃┃┃┃┣┫ ┃ ┣ ┗┓  ┃ ┃┃┃┃┃┃┃┃ ┣  ┃ ┣ ┃   ┃
  ┗━  ┗┛┣┛┻┛┛┗ ┻ ┗┛┗┛  ┗┛┗┛┛ ┗┣┛┗┛┗┛ ┻ ┗┛•  ━┛\e[0m\n"
