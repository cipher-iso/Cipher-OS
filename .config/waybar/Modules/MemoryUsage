#!/usr/bin/env bash

# [ BAR TEXT, {used} = RAM IN GiB ]
BAR_FORMAT="[  {used} GiB ]"

# [ TOOLTIP TITLE ]
TITLE="[ MEMORY USAGE ]"

# [ MIN RAM TO LIST (GiB) ]
THRESHOLD_GIB=1

# [ VALUE UNIT ]
UNIT="GiB"

# [ MIN GAP BETWEEN NAME AND VALUE ]
MIN_GAP=6

# [ MAX NAME LENGTH ]
MAX_NAME_LENGTH=30

# [ ALL CAPS NAMES (1 = YES, 0 = NO) ]
UPPERCASE=1

# [ WINDOW LABEL: class, title, initialClass OR initialTitle ]
LABEL_SOURCE="initialTitle"

# [ RENAME APPS: "ORIGINAL NAME=NEW NAME" (NOT CASE SENSITIVE) ]
RENAMES=(
  "VIVALDI - VIVALDI=VIVALDI"
  "KITTY=TERMINAL"
)

# [ MESSAGE IF NOTHING IS ABOVE THRESHOLD ]
EMPTY_MESSAGE="[ NO PROCESS USING ${THRESHOLD_GIB}+ GiBs ]"

# [ GLYPHS: TOP / MIDDLE / BOTTOM / SINGLE ROW ]
LEFT_TOP="┏";    RIGHT_TOP="┓"
LEFT_MID="┃";    RIGHT_MID="┃"
LEFT_BOT="┗";    RIGHT_BOT="┛"
LEFT_ONE="━";    RIGHT_ONE="━"

# [ END OF SETTINGS ]

# [ TOTAL USED RAM ]
used=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%.0f", (t-a)/1048576}' /proc/meminfo)

# [ JOIN RENAMES INTO ONE STRING FOR AWK ]
printf -v rename_list '%s\x1f' "${RENAMES[@]}"

# [ WINDOW LIST: PID <TAB> LABEL ]
windows() {
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg f "$LABEL_SOURCE" '
        .[]
        | select(.pid > 0)
        | [.pid, (.[$f]
            | gsub("[\u00a0\u2000-\u200a\u202f\u205f\u3000]"; " ")
            | gsub("[^ -~]"; "")
            | gsub(" +"; " ")
            | gsub("^ +| +$"; ""))]
        | select(.[1] != "")
        | @tsv'
}

# [ PROCESS LIST: PID, PPID, RSS, NAME (TAB SEPARATED) ]
procs() {
  ps -eo pid=,ppid=,rss=,comm= \
    | sed -E 's/^ *([0-9]+) +([0-9]+) +([0-9]+) +/\1\t\2\t\3\t/'
}

# [ BUILD TOOLTIP ]
tip=$(awk -F'\t' \
  -v title="$TITLE" \
  -v threshold="$THRESHOLD_GIB" \
  -v unit="$UNIT" \
  -v gap="$MIN_GAP" \
  -v maxlen="$MAX_NAME_LENGTH" \
  -v upper="$UPPERCASE" \
  -v empty="$EMPTY_MESSAGE" \
  -v renames="$rename_list" \
  -v lt="$LEFT_TOP"  -v rt="$RIGHT_TOP" \
  -v lm="$LEFT_MID"  -v rm="$RIGHT_MID" \
  -v lb="$LEFT_BOT"  -v rb="$RIGHT_BOT" \
  -v lo="$LEFT_ONE"  -v ro="$RIGHT_ONE" '
  function pad(s, w) { return sprintf("%-" w "s", s) }
  function center(s, w,   p, i, sp) {
    p = int((w - length(s)) / 2)
    sp = ""
    for (i = 0; i < p; i++) sp = sp " "
    return sp s
  }
  function esc(s) {
    gsub(/\\/, "", s); gsub(/"/, "", s)
    gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s)
    return s
  }

  # [ APPLY RENAME IF A MATCH EXISTS ]
  function rename(s,   u) {
    u = toupper(s)
    return (u in map) ? map[u] : s
  }

  # [ LOAD RENAME LIST ]
  BEGIN {
    rn = split(renames, entries, "\037")
    for (k = 1; k <= rn; k++) {
      eq = index(entries[k], "=")
      if (eq > 1) map[toupper(substr(entries[k], 1, eq - 1))] = substr(entries[k], eq + 1)
    }
  }

  # [ FIRST INPUT: WINDOWS ]
  FNR == NR { win[$1] = $2; next }

  # [ SECOND INPUT: PROCESSES ]
  { ppid[$1] = $2; rss[$1] = $3; comm[$1] = $4 }

  END {

    # [ ASSIGN EACH PROCESS TO NEAREST WINDOW ANCESTOR ]
    for (p in ppid) {
      cur = p; hops = 0
      while (!(cur in win) && (cur in ppid) && (cur + 0) > 1 && hops < 64) {
        cur = ppid[cur]; hops++
      }
      label = (cur in win) ? win[cur] : comm[p]
      mem[rename(label)] += rss[p]
    }

    limit = threshold * 1048576
    count = 0; longest = 0; maxv = 0

    # [ FILTER BY THRESHOLD ]
    for (n in mem) if (mem[n] > limit) {
      name = (upper == 1) ? toupper(n) : n
      name = substr(name, 1, maxlen)
      count++
      names[count] = name
      vals[count] = mem[n] / 1048576
      if (length(name) > longest) longest = length(name)
    }

    # [ NOTHING TO LIST ]
    if (count == 0) {
      w = (length(title) > length(empty)) ? length(title) : length(empty)
      printf "%s\\n%s", esc(center(title, w)), esc(center(empty, w))
      exit
    }

    # [ SORT, BIGGEST FIRST ]
    for (i = 1; i <= count; i++)
      for (j = i + 1; j <= count; j++)
        if (vals[j] > vals[i]) {
          t = vals[i]; vals[i] = vals[j]; vals[j] = t
          t = names[i]; names[i] = names[j]; names[j] = t
        }

    # [ BUILD VALUE STRINGS ]
    for (i = 1; i <= count; i++) {
      vstr[i] = sprintf("%4.1f %s", vals[i], unit)
      if (length(vstr[i]) > maxv) maxv = length(vstr[i])
    }

    # [ TITLE + ROWS ]
    width = longest + gap
    total = width + maxv + 4
    out = esc(center(title, total))
    for (i = 1; i <= count; i++) {

      # [ PICK GLYPHS BY POSITION ]
      if (count == 1)          { l = lo; r = ro }
      else if (i == 1)         { l = lt; r = rt }
      else if (i == count)     { l = lb; r = rb }
      else                     { l = lm; r = rm }

      out = out "\\n" esc(l " " pad(names[i], width) vstr[i] " " r)
    }
    printf "%s", out
  }' <(windows) <(procs))

# [ OUTPUT JSON FOR WAYBAR ]
text="${BAR_FORMAT//\{used\}/$used}"
printf '{"text":"%s","tooltip":"%s"}\n' "$text" "$tip"
