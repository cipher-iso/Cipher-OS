#!/usr/bin/env bash
set -o pipefail

ICON=""
TOOLTIP_MODE=0

# Check if -tooltip flag is set
for arg in "$@"; do
    [[ $arg == "-tooltip" ]] && TOOLTIP_MODE=1
done

# Wait for checkupdates to finish if already running
while pid=$(pgrep -x checkupdates); do
    wait "$pid" 2>/dev/null || true
done
sleep 1

# ------------------------
# Get updates
# ------------------------
official=$(checkupdates 2>/dev/null)
aur=$(yay -Qum 2>/dev/null)

# Build tooltip with line breaks and a blank line before USER REPOS
tooltip=""
[[ -n "$official" ]] && tooltip="[ OFFICIAL REPOS ]"$'\n'"$official"
[[ -n "$official" && -n "$aur" ]] && tooltip+=$'\n\n'   # <-- extra blank line here
[[ -n "$aur" ]] && tooltip+="[ USER REPOS ]"$'\n'"$aur"

# Count total updates
official_count=$(printf "%s\n" "$official" | grep -c .)
aur_count=$(printf "%s\n" "$aur" | grep -c .)
total_updates=$((official_count + aur_count))

# Uppercase conversions
updates_upper=$(printf "%s" "$total_updates" | tr '[:lower:]' '[:upper:]')
tooltip_upper=$(printf "%s" "$tooltip" | awk '{print toupper($0)}')

# ------------------------
# JSON output for Waybar with literal newlines
# ------------------------
if [[ "$updates_upper" == "0" ]]; then
    jq -nc --arg text "" --arg tooltip "$tooltip_upper" \
       '{text: $text, tooltip: $tooltip}'
else
    jq -nc --arg text "[ "$ICON" $updates_upper ]" --arg tooltip "$tooltip_upper" \
       '{text: $text, tooltip: $tooltip}'
fi
