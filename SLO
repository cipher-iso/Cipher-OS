#!/bin/bash

#########################################################
# BASE ENVIRONMENT VARIABLES (always enabled)
#########################################################

FPS_CAP=0
FPS_OVERRIDE=0
export PROTON_USE_NTSYNC=1
export PROTON_DLSS_UPGRADE=1
export PULSE_LATENCY_MSEC=60
#export PROTON_ENABLE_WAYLAND=1

#########################################################
# FLAGS
#########################################################

USE_HDR=0
USE_FG=0
USE_M=0
USE_NV=0

for arg in "$@"; do
    case "$arg" in
        -hdr) USE_HDR=1 ;;
        -fg)  USE_FG=1 ;;
        -m)   USE_M=1 ;;
        -nv)  USE_NV=1 ;;
        -f*)
            FPS_CAP="${arg#-f}"
            FPS_OVERRIDE=1
            ;;
        -all)
            USE_HDR=1
            USE_FG=1
            USE_M=1
            ;;
    esac
done

#########################################################
# APPLY HDR VARIABLES (Proton HDR mode)
#########################################################
if [[ "$USE_HDR" == "1" ]]; then
    export PROTON_ENABLE_WAYLAND=1
    export PROTON_ENABLE_HDR=1
    export ENABLE_HDR_WSI=1
    export DXVK_HDR=1
fi

#########################################################
# FRAME GENERATION / FRAMELIMIT
#########################################################
if [[ "$USE_FG" == "1" && "$FPS_OVERRIDE" == "0" ]]; then
    FPS_CAP=120
    export ENABLE_LSFG=1
    export LSFG_PROCESS="FRAMEGEN"
    export LSFG_PERF_MODE=1
fi


#########################################################
# MANGOHUD
#########################################################
if [[ "$USE_M" == "1" ]]; then
    export MANGOHUD=1
fi

#########################################################
# NVIDIA FRAME GENERATION / SMOOTH MOTION
#########################################################
if [[ "$USE_NV" == "1" && "$FPS_OVERRIDE" == "0" ]]; then
    FPS_CAP=120
    export NVPRESENT_ENABLE_SMOOTH_MOTION=1
fi

#########################################################
# APPLY FINAL FPS CAP
#########################################################
export DXVK_FRAME_RATE="$FPS_CAP"

#########################################################
# CLEAN ARGUMENTS (remove custom flags)
#########################################################
CLEAN_ARGS=()
for arg in "$@"; do
    case "$arg" in
        -hdr|-fg|-m|-nv|-all|-f*)
            ;;
        *)
            CLEAN_ARGS+=("$arg")
            ;;
    esac
done

#########################################################
# BASE LAUNCH COMMAND
#########################################################
BASE_CMD=("gamemoderun")

#########################################################
# LAUNCH GAME
#########################################################
exec "${BASE_CMD[@]}" "${CLEAN_ARGS[@]}"
