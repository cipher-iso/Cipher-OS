#!/usr/bin/env bash

# [ FILES ]
IDENTIFIERS="$HOME/.config/hypr/Config/Identifiers.conf"
UPDATE_SCRIPT="$HOME/Scripts/ReloadWaybar"  # Replace with your actual update script
LOG_FILE="$HOME/Scripts/ColorGen/listener.log"

# [ CHECK DEPENDENCIES ]
if ! command -v inotifywait >/dev/null; then
    echo "ERROR: Install inotify-tools first (sudo apt install inotify-tools)" | tee -a "$LOG_FILE"
    exit 1
fi

echo "[$(date '+%F %T')] Listener started for $IDENTIFIERS" | tee -a "$LOG_FILE"

# [ MAIN LOOP ]
while true; do
    # Wait until the file is closed after being written
    inotifywait -e close_write "$IDENTIFIERS" >/dev/null 2>&1

    echo "[$(date '+%F %T')] Change detected in Identifiers.conf, running update script..." | tee -a "$LOG_FILE"

    # Run the color-update script
    if [ -f "$UPDATE_SCRIPT" ]; then
        "$UPDATE_SCRIPT"
        echo "[$(date '+%F %T')] Update complete." | tee -a "$LOG_FILE"
    else
        echo "[$(date '+%F %T')] ERROR: Update script not found: $UPDATE_SCRIPT" | tee -a "$LOG_FILE"
    fi
done
