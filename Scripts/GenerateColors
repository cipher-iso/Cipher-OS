#!/usr/bin/env bash

# [ FILE PATHS ]
IDENTIFIERS="$HOME/.config/hypr/Config/Identifiers.lua"
CSS_FILE="$HOME/Scripts/ColorGen/Colors.css"
LUA_FILE="$HOME/Scripts/ColorGen/Colors.lua"
ZSH_FILE="$HOME/Scripts/ColorGen/Colors.zsh"
ENCOM="$HOME/.config/kitty/ENCOM.conf"
KVANTUM_FILE="$HOME/.config/Kvantum/KvMatrix/KvMatrix.kvconfig"

# [ DEFAULT COLORS ]
DEFAULT_BACKGROUND="000000"
DEFAULT_PRIMARY="00FF40"
DEFAULT_SECONDARY="EBFAFA"
DEFAULT_ACCENT1="323449"
DEFAULT_ACCENT2="212337"
DEFAULT_ACCENT3="10111C"

# [ HELPER: READ LUA VARIABLE ]
lua_get() {
    grep -m1 "^$1\s*=" "$IDENTIFIERS" | sed 's/.*=\s*"\(.*\)".*/\1/'
}

# [ HELPER: SET LUA VARIABLE ]
lua_set() {
    sed -i "s|^$1\s*=.*|$1      = \"$2\"|" "$IDENTIFIERS"
}

# [ ARGUMENT PARSING ]
for arg in "$@"; do
    case "$arg" in
        -d|--default)
            BACKGROUND="$DEFAULT_BACKGROUND"
            PRIMARY="$DEFAULT_PRIMARY"
            SECONDARY="$DEFAULT_SECONDARY"
            ACCENT1="$DEFAULT_ACCENT1"
            ACCENT2="$DEFAULT_ACCENT2"
            ACCENT3="$DEFAULT_ACCENT3"

            # [ RESTORE IDENTIFIERS ]
            lua_set "BACKGROUND" "$BACKGROUND"
            lua_set "PRIMARY"    "$PRIMARY"
            lua_set "SECONDARY"  "$SECONDARY"
            lua_set "ACCENT1"    "$ACCENT1"
            lua_set "ACCENT2"    "$ACCENT2"
            lua_set "ACCENT3"    "$ACCENT3"

            # [ RELOAD SYSTEM ]
            ReloadSystem
            exit 0
            ;;
    esac
done

# [ VALIDATION ]
[ -f "$IDENTIFIERS" ] || { echo "Missing Identifiers.lua."; exit 1; }

# [ SOURCE COLORS FROM IDENTIFIERS IF NOT DEFAULT FLAG ]
if [ -z "$PRIMARY" ]; then
    BACKGROUND=$(lua_get "BACKGROUND")
    PRIMARY=$(lua_get "PRIMARY")
    SECONDARY=$(lua_get "SECONDARY")
    ACCENT1=$(lua_get "ACCENT1")
    ACCENT2=$(lua_get "ACCENT2")
    ACCENT3=$(lua_get "ACCENT3")
fi

# [ COLOR CONVERSION FUNCTIONS ]
hex_to_rgb() {
    printf "%d %d %d" "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"
}

rgb_to_hex() {
    printf "%02X%02X%02X" "$1" "$2" "$3"
}

hex_to_rgb_string() {
    printf "%d;%d;%d" "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"
}

hsl_transform() {
    read r g b <<< "$(hex_to_rgb "$1")"

    awk -v r="$r" -v g="$g" -v b="$b" \
        -v shift="$2" -v s_scale="$3" -v l_scale="$4" '
    function max(a,b){return a>b?a:b}
    function min(a,b){return a<b?a:b}
    BEGIN{
        r/=255; g/=255; b/=255
        maxc=max(r,max(g,b))
        minc=min(r,min(g,b))
        delta=maxc-minc
        l=(maxc+minc)/2

        if(delta==0){h=0; s=0}
        else{
            if(l<0.5) s=delta/(maxc+minc)
            else s=delta/(2-maxc-minc)

            if(maxc==r) h=(g-b)/delta
            else if(maxc==g) h=2+(b-r)/delta
            else h=4+(r-g)/delta

            h*=60
            if(h<0) h+=360
        }

        h=(h+shift)%360
        if(h<0) h+=360

        s*=s_scale; if(s>1)s=1;if(s<0)s=0
        l*=l_scale; if(l>1)l=1;if(l<0)l=0

        if(s==0){r=g=b=l}
        else{
            q = l<0.5 ? l*(1+s) : l+s-l*s
            p = 2*l - q
            hk = h/360
            t[0]=hk+1/3; t[1]=hk; t[2]=hk-1/3

            for(i=0;i<3;i++){
                if(t[i]<0)t[i]+=1
                if(t[i]>1)t[i]-=1

                if(t[i]<1.0/6)c=p+(q-p)*6*t[i]
                else if(t[i]<0.5)c=q
                else if(t[i]<2.0/3)c=p+(q-p)*(2.0/3-t[i])*6
                else c=p

                rgb[i]=c
            }

            r=rgb[0]; g=rgb[1]; b=rgb[2]
        }

        printf "%d %d %d", int(r*255+0.5), int(g*255+0.5), int(b*255+0.5)
    }'
}

# [ DERIVED COLORS ]
read g1r g1g g1b <<< "$(hsl_transform "$PRIMARY" -15 1.0 1.0)"
read g2r g2g g2b <<< "$(hsl_transform "$PRIMARY" 25 1.0 1.0)"
GRADIENT1=$(rgb_to_hex "$g1r" "$g1g" "$g1b")
GRADIENT2=$(rgb_to_hex "$g2r" "$g2g" "$g2b")

read da1r da1g da1b <<< "$(hsl_transform "$PRIMARY" 100 0.187 0.482)"
read da2r da2g da2b <<< "$(hsl_transform "$PRIMARY" 100 0.252 0.345)"
read da3r da3g da3b <<< "$(hsl_transform "$PRIMARY" 0 1.0 0.529)"

AUTO_ACCENT1=$(rgb_to_hex "$da1r" "$da1g" "$da1b")
AUTO_ACCENT2=$(rgb_to_hex "$da2r" "$da2g" "$da2b")
AUTO_ACCENT3=$(rgb_to_hex "$da3r" "$da3g" "$da3b")

ACCENT1="${ACCENT1:-$AUTO_ACCENT1}"
ACCENT2="${ACCENT2:-$AUTO_ACCENT2}"
ACCENT3="${ACCENT3:-$AUTO_ACCENT3}"

# [ WRITE CSS FILE ]
cat > "$CSS_FILE" <<EOF
@define-color bg #$BACKGROUND;
@define-color fg #$PRIMARY;
@define-color fg2 #$SECONDARY;
@define-color accent1 #$ACCENT1;
@define-color accent2 #$ACCENT2;
@define-color accent3 #$ACCENT3;
@define-color grad1 #$GRADIENT1;
@define-color grad2 #$GRADIENT2;
EOF

# [ WRITE LUA FILE ]
cat > "$LUA_FILE" <<EOF
local M = {}
M.BACKGROUND="#$BACKGROUND"
M.PRIMARY="#$PRIMARY"
M.SECONDARY="#$SECONDARY"
M.ACCENT1="#$ACCENT1"
M.ACCENT2="#$ACCENT2"
M.ACCENT3="#$ACCENT3"
M.GRADIENT1="#$GRADIENT1"
M.GRADIENT2="#$GRADIENT2"
return M
EOF

# [ WRITE ZSH FILE ]
cat > "$ZSH_FILE" <<EOF
PRIMARY="$(hex_to_rgb_string $PRIMARY)"
SECONDARY="$(hex_to_rgb_string $SECONDARY)"
ACCENT1="$(hex_to_rgb_string $ACCENT1)"
ACCENT2="$(hex_to_rgb_string $ACCENT2)"
ACCENT3="$(hex_to_rgb_string $ACCENT3)"
GRADIENT1="$(hex_to_rgb_string $GRADIENT1)"
GRADIENT2="$(hex_to_rgb_string $GRADIENT2)"

hPRIMARY="#$PRIMARY"
hSECONDARY="#$SECONDARY"
hACCENT1="#$ACCENT1"
hACCENT2="#$ACCENT2"
hACCENT3="#$ACCENT3"
hGRADIENT1="#$GRADIENT1"
hGRADIENT2="#$GRADIENT2"
EOF

# [ UPDATE KITTY ]
sed -i \
        -e "s|^active_tab_background.*|active_tab_background   #$PRIMARY|" \
        -e "s|^inactive_tab_foreground.*|inactive_tab_foreground #$SECONDARY|" \
        "$ENCOM"

# [ UPDATE KVANTUM / QT6 ]
sed -i \
        -e "s|^window\.color=.*|window.color=#$BACKGROUND|" \
        -e "s|^inactive\.window\.color=.*|inactive.window.color=#$BACKGROUND|" \
        -e "s|^base\.color=.*|base.color=#$BACKGROUND|" \
        -e "s|^inactive\.base\.color=.*|inactive.base.color=#$BACKGROUND|" \
        -e "s|^dark\.color=.*|dark.color=#$ACCENT3|" \
        -e "s|^inactive\.highlight\.color=.*|inactive.highlight.color=#$ACCENT3|" \
        -e "s|^mid\.light\.color=.*|mid.light.color=#$ACCENT2|" \
        -e "s|^mid\.color=.*|mid.color=#$ACCENT2|" \
        -e "s|^disabled\.text\.color=.*|disabled.text.color=#$ACCENT2|" \
        -e "s|^light\.color=.*|light.color=#$ACCENT1|" \
        -e "s|^button\.color=.*|button.color=#$PRIMARY|" \
        -e "s|^highlight\.color=.*|highlight.color=#$PRIMARY|" \
        -e "s|^text\.color=.*|text.color=#$PRIMARY|" \
        -e "s|^inactive\.text\.color=.*|inactive.text.color=#$PRIMARY|" \
        -e "s|\(text\..*\.color=\).*|\1#$PRIMARY|" \
        -e "s|^window\.text\.color=.*|window.text.color=#$SECONDARY|" \
        -e "s|^inactive\.window\.text\.color=.*|inactive.window.text.color=#$SECONDARY|" \
        -e "s|^button\.text\.color=.*|button.text.color=#$SECONDARY|" \
        -e "s|^tooltip\.text\.color=.*|tooltip.text.color=#$SECONDARY|" \
        -e "s|^highlight\.text\.color=.*|highlight.text.color=#$SECONDARY|" \
        -e "s|^progress\.indicator\.text\.color=.*|progress.indicator.text.color=#$SECONDARY|" \
        "$KVANTUM_FILE"
