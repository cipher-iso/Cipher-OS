#!/usr/bin/env bash

s() {
    local term="$1"

    local WHITE="\033[38;2;235;250;250m"
    local ORANGE="\033[38;2;255;165;0m"
    local GREEN="\033[38;2;0;255;64m"
    local IDX="\033[38;2;50;52;73m"    # #323449 for [ i ]
    local DESC="\033[38;2;33;35;55m"   # #212337 for descriptions
    local BOLD="\033[1m"
    local RESET="\033[0m"

    if [[ -z "$term" ]]; then
        echo -e "\n${GREEN}${BOLD}[ PACKAGE SEARCH: ${WHITE}s <TERM> ${GREEN}]${RESET}"
        return
    fi

    local pac_max=5 aur_max=5
    local -a pac_results pac_desc aur_results aur_desc all_results
    local i=0

    # ---- Pacman search ----
    mapfile -t pac_results < <(
        pacman -Ss "$term" 2>/dev/null \
        | awk -F'/' '{print $2}' \
        | awk '{print $1}' \
        | grep -i "$term" \
        | head -n "$pac_max"
    )

    # Get Pacman package descriptions
    for pkg in "${pac_results[@]}"; do
        desc=$(pacman -Si "$pkg" 2>/dev/null | awk -F': ' '/Description/ {print $2}')
        pac_desc+=( "$desc" )
    done

    echo -e "\n${GREEN}${BOLD}[ TOP ${pac_max} PAC RESULTS ]${RESET}"
    if (( ${#pac_results[@]} == 0 )); then
        echo -e "  ${BOLD}ERR:${RESET} ZER0 RESULTS"
    else
        for idx in "${!pac_results[@]}"; do
            echo -e "${ORANGE}${BOLD}[ $i ]${RESET} > ${pac_results[$idx]}"
            echo -e "${BOLD}${IDX}[ i ]${RESET} ${DESC}${pac_desc[$idx]}${RESET}"
            ((i++))
        done
    fi

    # ---- AUR search ----
    local helper
    helper=$(command -v yay || command -v paru)

    if [[ -n "$helper" ]]; then
        mapfile -t aur_results < <(
            "$helper" -Ss "$term" 2>/dev/null \
            | awk -F'/' '{print $2}' \
            | awk '{print $1}' \
            | grep -i "$term" \
            | head -n "$aur_max"
        )
        # Get AUR package descriptions
        for pkg in "${aur_results[@]}"; do
            desc=$("$helper" -Si "$pkg" 2>/dev/null | awk -F': ' '/Description/ {print $2}')
            aur_desc+=( "$desc" )
        done
    fi

    echo -e "\n${GREEN}${BOLD}[ TOP ${aur_max} AUR RESULTS ]${RESET}"
    if (( ${#aur_results[@]} == 0 )); then
        echo -e "  ${BOLD}ERR:${RESET} ZER0 RESULTS"
    else
        for idx in "${!aur_results[@]}"; do
            echo -e "${ORANGE}${BOLD}[ $i ]${RESET} > ${aur_results[$idx]}"
            echo -e "${BOLD}${IDX}[ i ]${RESET} ${DESC}${aur_desc[$idx]}${RESET}"
            ((i++))
        done
    fi

    all_results=( "${pac_results[@]}" "${aur_results[@]}" )
    (( ${#all_results[@]} > 0 )) || return

    local max_index=$(( ${#all_results[@]} - 1 ))
    local choice

    echo -ne "\n${GREEN}${BOLD}[ INSTALL PACKAGE: ${WHITE}<0-${max_index}> ${GREEN}| ${WHITE}ENTER ${GREEN}TO SKIP ] > ${RESET}"
    read -r choice

    [[ -z "$choice" ]] && return
    [[ "$choice" =~ ^[0-9]+$ ]] || return
    (( choice >= 0 && choice <= max_index )) || return

    local selected="${all_results[$choice]}"
    echo -e "${GREEN}${BOLD}[ INSTALLING ${WHITE}$selected ${GREEN}]${RESET}"

    if (( choice < ${#pac_results[@]} )); then
        sudo pacman -S "$selected"
    elif [[ -n "$helper" ]]; then
        "$helper" -S "$selected"
    else
        echo -e "${GREEN}[ NO AUR HELPER FOUND ]${RESET}"
    fi
}

s "$@"
