#!/usr/bin/env bash
set -e

MODE="gif"
FPS=30
INPUT=""
VERT_RES=""

# Parse arguments
for arg in "$@"; do
    case "$arg" in
        -webp) MODE="webp";;
        *)
            if [[ -z "$INPUT" ]]; then INPUT="$arg"
            elif [[ -z "$FPS" ]]; then FPS="$arg"
            else VERT_RES="$arg"; fi
            ;;
    esac
done

[[ -z "$INPUT" ]] && { echo "Usage: $0 <input> [fps] [vertical] [-webp]"; exit 1; }

BASENAME="${INPUT##*/}"
NAME="${BASENAME%.*}"
OUTDIR="$HOME/Pictures/Converted GIFS"
mkdir -p "$OUTDIR"

# Build scale string
if [[ -n "$VERT_RES" ]]; then
    SCALE="scale=-2:$VERT_RES:flags=fast_bilinear"
else
    SCALE="scale=min(iw\,1920):min(ih\,1080):force_original_aspect_ratio=decrease:flags=fast_bilinear"
fi

# -------- WEBP --------
if [[ "$MODE" == "webp" ]]; then
    OUTPUT="$OUTDIR/$NAME.webp"
    ffmpeg -y -hwaccel auto -threads 0 -i "$INPUT" \
        -vf "fps=$FPS,$SCALE" \
        -c:v libwebp -lossless 0 -compression_level 1 -q:v 80 -loop 0 \
        "$OUTPUT"
    echo "Created WEBP: $OUTPUT ($FPS fps)"
    exit 0
fi

# -------- GIF --------
OUTPUT="$OUTDIR/$NAME.gif"
ffmpeg -y -hwaccel auto -threads 0 -i "$INPUT" \
    -vf "fps=$FPS,$SCALE" -pix_fmt rgb8 -loop 0 "$OUTPUT"

echo "Created GIF: $OUTPUT ($FPS fps)"
