#!/usr/bin/env bash

# [ FILES AND COMMANDS ]
STATE_FILE="$HOME/Scripts/.Screenshare-ON"
TOGGLE="ScreenShare"
IDENTIFIERS="$HOME/.config/hypr/Config/Identifiers.conf"
GEN_CMD="ReloadWaybar"

# [ SCREENSHARE STATE ]
DID_ENABLE=false

# [ ENABLE SCREENSHARE IF DISABLED ]
if [ ! -f "$STATE_FILE" ]; then
    "$TOGGLE" toggle
    DID_ENABLE=true
fi

# [ RUN HYPRPICKER AND CAPTURE COLOR ]
sleep 0.02
PICKED_COLOR="$(hyprpicker -a 2>/dev/null | tr -d '#\n')"

# [ VALIDATE COLOR ]
if [[ ! "$PICKED_COLOR" =~ ^[0-9A-Fa-f]{6}$ ]]; then
    echo "Invalid color picked: $PICKED_COLOR"
    [ "$DID_ENABLE" = true ] && "$TOGGLE" toggle
    exit 1
fi

# [ OVERWRITE $PRIMARY IN IDENTIFIERS ]
sed -i "s|^\$PRIMARY=.*|\$PRIMARY=$PICKED_COLOR|" "$IDENTIFIERS"

# [ RESTORE SCREENSHARE STATE ]
if [ "$DID_ENABLE" = true ]; then
    "$TOGGLE" toggle
fi
