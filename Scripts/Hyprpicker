#!/usr/bin/env bash
STATE_FILE="$HOME/Scripts/.Screenshare-ON"
IDENTIFIERS="$HOME/.config/hypr/Config/Identifiers.lua"

expose() {
    hyprctl eval "hl.window_rule({ name = 'SCREENSHARE', no_screen_share = false, match = { class = '^(discord|vivaldi-stable|steam)$' } })"
    touch "$STATE_FILE"
}

protect() {
    hyprctl eval "hl.window_rule({ name = 'SCREENSHARE', no_screen_share = true, match = { class = '^(discord|vivaldi-stable|steam)$' } })"
    rm -f "$STATE_FILE"
}

# [ EXPOSE IF CURRENTLY PROTECTED ]
DID_EXPOSE=false
if [ ! -f "$STATE_FILE" ]; then
    expose
    DID_EXPOSE=true
    sleep 0.1
fi

# [ RUN HYPRPICKER AND CAPTURE COLOR ]
PICKED_COLOR="$(hyprpicker -a 2>/dev/null | tr -d '#\n')"

# [ VALIDATE COLOR ]
if [[ ! "$PICKED_COLOR" =~ ^[0-9A-Fa-f]{6}$ ]]; then
    echo "Invalid color picked: $PICKED_COLOR"
    [ "$DID_EXPOSE" = true ] && protect
    exit 1
fi

# [ OVERWRITE PRIMARY IN IDENTIFIERS ]
sed -i "s|^PRIMARY\s*=.*|PRIMARY      = \"$PICKED_COLOR\"|" "$IDENTIFIERS"

# [ RESTORE PROTECTED STATE ]
if [ "$DID_EXPOSE" = true ]; then
    protect
fi

# [ RELOAD SYSTEM ]
ReloadSystem
